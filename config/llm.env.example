# CS Demo Coach LLM config
# Copy this file to:
#   config/llm.env
#
# Then fill real values in config/llm.env.
# Do NOT commit config/llm.env to git.

# OpenAI-compatible endpoint examples:
# OpenAI:
# CS_DEMO_COACH_LLM_BASE_URL=https://api.openai.com/v1
#
# Other OpenAI-compatible providers usually also use /v1:
# CS_DEMO_COACH_LLM_BASE_URL=https://your-provider.example/v1

CS_DEMO_COACH_LLM_BASE_URL=
CS_DEMO_COACH_LLM_API_KEY=
CS_DEMO_COACH_LLM_MODEL=

# Conservative defaults
CS_DEMO_COACH_LLM_TEMPERATURE=0.2
CS_DEMO_COACH_LLM_MAX_TOKENS=4500
CS_DEMO_COACH_LLM_TIMEOUT_SEC=120
