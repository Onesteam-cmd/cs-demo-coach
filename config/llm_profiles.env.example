# CS Demo Coach — роли моделей
# Скопируйте файл в config/llm_profiles.env и укажите модели,
# доступные у вашего OpenAI-compatible провайдера.
#
# API key и base URL хранятся отдельно в config/llm.env.

CS_DEMO_COACH_MODEL_CORE=
CS_DEMO_COACH_MODEL_CHEAP_JUDGE=
CS_DEMO_COACH_MODEL_SEMANTIC_JUDGE=
CS_DEMO_COACH_MODEL_RU_EDITOR=
CS_DEMO_COACH_MODEL_REPAIR=
CS_DEMO_COACH_MODEL_ARBITER=

# cheap | balanced | full_quality
CS_DEMO_COACH_DEFAULT_QUALITY_PROFILE=balanced
